digraph methodology {
	bgcolor=white fontname=Arial fontsize=11 nodesep=0.6 pad=0.15 rankdir=TB ranksep=0.28
	node [fontname=Arial fontsize=11 margin="0.12,0.06" penwidth=1.2 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#52514e" fontname=Arial fontsize=11 penwidth=1.1]
	d [label=<<B>1. Data collection</B><BR/>BDI-I (21), FCRI (42),<BR/>demographic &amp; clinical> color="#6b6a66" fillcolor="#f1f1ef" width=2.45]
	c [label=<<B>2. Data curation</B><BR/>scoring, quality filters,<BR/>provenance, targets> color="#2a78d6" fillcolor="#e6f0fd" width=2.45]
	p [label=<<B>3. Preprocessing</B><BR/>encoding, scaling,<BR/>imbalance (in-fold)> color="#2a78d6" fillcolor="#e6f0fd" width=2.45]
	s [label=<<B>4. Statistical analysis</B><BR/>bivariate tests,<BR/>correlation, regression> color="#a87000" fillcolor="#fdf1d6" width=2.45]
	f [label=<<B>5. Feature selection</B><BR/>MI, χ², RFE, L1, Boruta<BR/>(in every training fold)> color="#14875c" fillcolor="#e2f5ec" width=2.45]
	t [label=<<B>6. Model training</B><BR/>LR, RF, XGBoost, SVM,<BR/>voting, stacking> color="#14875c" fillcolor="#e2f5ec" width=2.45]
	e [label=<<B>7. Evaluation</B><BR/>nested CV, bootstrap CI,<BR/>significance tests> color="#c4471b" fillcolor="#fdeae1" width=2.45]
	x [label=<<B>8. Explainability</B><BR/>SHAP: global, group,<BR/>patient level> color="#6250d6" fillcolor="#ecebfb" width=2.45]
	w [label=<<B>9. Web decision support</B><BR/>Streamlit application> color="#6b6a66" fillcolor="#f1f1ef" width=2.45]
	d -> c
	c -> p
	p -> s
	s -> f
	{
		rank=same
		f
		t
	}
	{
		rank=same
		s
		e
	}
	{
		rank=same
		p
		x
	}
	{
		rank=same
		c
		w
	}
	f -> t
	e -> t [dir=back]
	x -> e [dir=back]
	w -> x [dir=back]
}
